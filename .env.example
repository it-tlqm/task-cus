# Environment configuration template
DATABASE_URL="postgresql://user:password@localhost:5432/talung_cus_work?schema=public"
JWT_SECRET="your_jwt_secret_change_in_production"
NEXT_PUBLIC_APP_TITLE="Hệ thống Quản lý Kế hoạch & Công việc — Hải quan Tà Lùng"
NEXT_PUBLIC_DEMO_MODE="true"
# Web push (VAPID) — sinh 1 lần bằng: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="paste-public-key"
VAPID_PRIVATE_KEY="paste-private-key"
VAPID_SUBJECT="mailto:your-unit@example.vn"
# AI hỗ trợ (Google Gemini) — lấy key miễn phí tại https://aistudio.google.com/apikey
# Bỏ trống cả 2 biến thì mọi nút AI tự ẩn, hệ thống chạy bình thường.
GOOGLE_GENERATIVE_AI_KEY="AIza...your-key"
# Tùy chọn: đổi model (mặc định gemini-flash-latest, tự lùi gemini-flash-lite-latest ~500 lượt/ngày khi hết hạn mức)
# AI_MODEL="gemini-flash-latest"
