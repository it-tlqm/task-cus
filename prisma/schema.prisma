datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. CƠ CẤU TỔ CHỨC & NHÂN SỰ
// ----------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  units OrgUnit[]

  @@map("organizations")
}

model OrgUnit {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  parentId  String?  @map("parent_id")
  code      String   @unique
  name      String
  level     Int      @default(1)
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       OrgUnit?           @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children     OrgUnit[]          @relation("OrgUnitHierarchy")
  assignments  PersonAssignment[]
  roleGrants   RoleGrant[]
  tasks        Task[]
  plans        Plan[]
  routines     RoutineEntry[]
  reportSnapshots ReportSnapshot[]
  dutyRosters  DutyRoster[]
  dutyPositions DutyPosition[]
  dutyDayInfos DutyDayInfo[]
  departmentWorkItems DepartmentWorkItem[]
  workCatalogEntries  WorkCatalogEntry[]
  workCatalogDepartmentMappings WorkCatalogDepartmentMapping[]

  primaryOwnedWorkItems PersonalWorkItem[] @relation("WorkItemPrimaryOwnerUnit")
  @@map("org_units")
}

model Position {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments PersonAssignment[]

  @@map("positions")
}

model Person {
  id        String   @id @default(uuid())
  code      String   @unique
  fullName  String   @map("full_name")
  email     String?  @unique
  phone     String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account          Account?
  assignments      PersonAssignment[]
  ownedTasks       Task[]             @relation("TaskOwner")
  taskAssignees    TaskAssignee[]
  taskUpdates      TaskUpdate[]
  workItems        PersonalWorkItem[]
  routines         RoutineEntry[]
  deadlineRequests DeadlineRequest[]  @relation("RequestedBy")
  notifications    Notification[]
  snapshotsLocked  ReportSnapshot[]   @relation("SnapshotLocker")
  attachments      TaskAttachment[]   @relation("AttachmentUploader")
  monthlyResults   MonthlyWorkResult[]
  workCatalogImports WorkCatalogVersion[] @relation("WorkCatalogImporter")
  workEvidences    WorkEvidence[]        @relation("EvidenceUploader")
  leaveRequests    LeaveRequest[]  @relation("LeaveRequester")
  leaveHandovers   LeaveRequest[]  @relation("LeaveHandover")
  pushSubscriptions PushSubscription[]
  dutyRosters      DutyRoster[]
  createdDutyPositions DutyPosition[] @relation("DutyPositionCreator")
  handledDocs      OfficialDoc[]
  taskComments     TaskComment[]
  commentReactions CommentReaction[]
  feedbacks        Feedback[]
  createdDeptWorkItems DepartmentWorkItem[] @relation("DeptWorkItemCreator")

  primaryOwnedWorkItems PersonalWorkItem[] @relation("WorkItemPrimaryOwner")
  workItemAssignments   WorkItemAssignment[]
  workItemReviews        WorkItemReview[]
  createdWorkItemSeries WorkItemSeries[]    @relation("WorkItemSeriesCreator")
  @@map("people")
}

model PersonAssignment {
  id            String    @id @default(uuid())
  personId      String    @map("person_id")
  unitId        String    @map("unit_id")
  positionId    String?   @map("position_id")
  isPrimary     Boolean   @default(true) @map("is_primary")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit     OrgUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  position Position? @relation(fields: [positionId], references: [id])

  @@map("person_assignments")
}

// ----------------------------------------------------
// 2. TÀI KHOẢN, VAI TRÒ & PHÂN QUYỀN
// ----------------------------------------------------

model Account {
  id           String    @id @default(uuid())
  personId     String    @unique @map("person_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  status       String    @default("ACTIVE") // ACTIVE, LOCKED, DISABLED
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  person     Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleGrants RoleGrant[]
  auditLogs  AuditEvent[]

  @@map("accounts")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  roleGrants      RoleGrant[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleGrant {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  roleId      String    @map("role_id")
  scopeType   String    @default("OWN") @map("scope_type") // OWN, ASSIGNED, DEPARTMENT, SUBTREE, ORGANIZATION
  scopeUnitId String?   @map("scope_unit_id")
  validFrom   DateTime  @default(now()) @map("valid_from")
  validTo     DateTime? @map("valid_to")
  createdAt   DateTime  @default(now()) @map("created_at")

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeUnit OrgUnit? @relation(fields: [scopeUnitId], references: [id])

  @@map("role_grants")
}

// ----------------------------------------------------
// 3. DANH MỤC NGHIỆP VỤ & HOẠT ĐỘNG MẪU (EXCEL SEED)
// ----------------------------------------------------

model ActivityGroup {
  id          String   @id @default(uuid())
  code        String   @unique // TTHQ, GSHQ, TON_DONG, DANH_GIA_HQ, DANH_GIA_NGAY_TUAN
  name        String
  sourceRow   Int      @map("source_row")
  sortOrder   Int      @default(0) @map("sort_order")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  templates ActivityTemplate[]
  planItems PlanItem[]
  workItems PersonalWorkItem[]

  @@map("activity_groups")
}

model ActivityTemplate {
  id              String   @id @default(uuid())
  groupId         String   @map("group_id")
  code            String   @unique // TTHQ-01..22, GSHQ-01..20, etc.
  title           String
  description     String?
  sourceRawText   String   @map("source_raw_text")
  sourceRow       Int      @map("source_row")
  defaultPriority String   @default("Cao") @map("default_priority")
  reportingMode   String   @default("UNCONFIGURED") @map("reporting_mode") // UNCONFIGURED, EVERY_PERIOD, ON_OCCURRENCE, ON_ASSIGNMENT, NO_REPORT
  reviewStatus    String   @default("NEEDS_REVIEW") @map("review_status") // NEEDS_REVIEW, VERIFIED, RETIRED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  group       ActivityGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workItems   PersonalWorkItem[]
  routines    RoutineEntry[]

  @@map("activity_templates")
}

// ----------------------------------------------------
// 3b. DANH MỤC ĐẦU VIỆC RIÊNG THEO BỘ PHẬN (YC-25)
// Tách biệt với danh mục thường xuyên (48 mẫu) và danh mục sản phẩm QĐ1277.
// Ngừng sử dụng (INACTIVE) thay vì xóa cứng khi đã có kế hoạch tham chiếu;
// nội dung đã chọn vào kế hoạch là bản sao (title trên PersonalWorkItem)
// nên sửa danh mục không làm đổi nội dung kế hoạch cũ.
// ----------------------------------------------------

model DepartmentWorkItem {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  title       String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE (ngừng sử dụng)
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  unit      OrgUnit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy Person?            @relation("DeptWorkItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  workItems PersonalWorkItem[]

  @@unique([unitId, title])
  @@index([unitId, status])
  @@map("department_work_items")
}

// ----------------------------------------------------
// 3c. DANH MỤC CÔNG VIỆC THƯỜNG XUYÊN (TX) — YC-31
// Mỗi lần nhập file = 1 phiên bản bất biến; phiên bản cũ chuyển SUPERSEDED,
// KHÔNG xóa — đầu việc đã gắn vẫn mở/sửa bình thường. Tách biệt hoàn toàn với
// ActivityTemplate (48 mẫu cũ), DepartmentWorkItem (YC-25) và ProductItem (QĐ1277).
// ----------------------------------------------------

model WorkCatalogVersion {
  id             String   @id @default(uuid())
  code           String   @unique // TX-20261021-01
  title          String   @default("Danh mục công việc thường xuyên")
  sourceFileName String?  @map("source_file_name")
  sourceSheet    String?  @map("source_sheet")
  entryCount     Int      @map("entry_count")
  importHash     String   @map("import_hash") // SHA-256 nội dung chuẩn hóa — chống nhập lại cùng file
  status         String   @default("ACTIVE") // ACTIVE, SUPERSEDED
  // MAPPED: chỉ chọn được nhóm đã ánh xạ + kích hoạt cho bộ phận của cán bộ.
  // ALL: mọi cán bộ chọn được mọi nhóm (khi Hải quan chưa xác nhận ánh xạ bộ phận).
  selectionMode  String   @default("MAPPED") @map("selection_mode")
  note           String?
  importedById   String?  @map("imported_by_id")
  importedAt     DateTime @default(now()) @map("imported_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  importedBy Person?            @relation("WorkCatalogImporter", fields: [importedById], references: [id], onDelete: SetNull)
  entries    WorkCatalogEntry[]

  @@index([status, importedAt])
  @@map("work_catalog_versions")
}

model WorkCatalogEntry {
  id              String   @id @default(uuid())
  versionId       String   @map("version_id")
  code            String // Mã đầu việc ổn định theo nhóm: NV-01, CNTT-01, CBL-01, PT-01, TH-01, DANG-01
  department      String // Tên bộ phận đúng như file nguồn (6 bộ phận)
  departmentOrder Int      @default(0) @map("department_order")
  groupCode       String   @map("group_code") // Mã nhóm nguồn: NV, CNTT, CBL, PT, TH, DANG
  unitId          String?  @map("unit_id") // Gắn đơn vị thật sau khi Hải quan xác nhận (B2 phiếu 04)
  title           String
  convertFactor   Decimal? @map("convert_factor") @db.Decimal(12, 4) // Hệ số quy đổi trong file nguồn: NULL = chưa có, 0 = hệ số bằng 0
  sortOrder       Int      @default(0) @map("sort_order")
  sourceRow       Int      @default(0) @map("source_row") // Dòng Excel gốc để đối soát
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE (ngừng dùng riêng lẻ)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  version   WorkCatalogVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  unit      OrgUnit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  workItems PersonalWorkItem[]

  // Mã đầu việc là khoá duy nhất: file nguồn TX1 có tên trùng trong CÙNG nhóm,
  // nên không thể để (versionId, department, title) là unique.
  @@unique([versionId, code])
  @@index([versionId, status, departmentOrder, sortOrder])
  @@index([versionId, department, title])
  @@map("work_catalog_entries")
}

// YC-31 — Ánh xạ nhóm TX (tên bộ phận trong file nguồn) với đơn vị tổ chức thật.
// Mặc định isActive=false: nhóm chưa được xác nhận KHÔNG phát cho người dùng.
// Tên nhóm nguồn được giữ nguyên; không tự tạo org_units từ file Excel.
model WorkCatalogDepartmentMapping {
  id          String    @id @default(uuid())
  department  String    @unique
  unitId      String?   @map("unit_id")
  isActive    Boolean   @default(false) @map("is_active")
  note        String?
  confirmedBy String?   @map("confirmed_by")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  unit OrgUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([unitId, isActive])
  @@map("work_catalog_department_mappings")
}

// ----------------------------------------------------
// 3d. MINH CHỨNG CÔNG VIỆC — YC-32
// Chỉ lưu metadata + khóa lưu trữ; KHÔNG phát URL công khai. Mọi lượt tải đi qua
// route kiểm tra quyền và ghi AuditEvent (EVIDENCE_DOWNLOAD).
// ----------------------------------------------------

model WorkEvidence {
  id              String   @id @default(uuid())
  workItemId      String   @map("work_item_id")
  monthlyResultId String?  @map("monthly_result_id")
  fileName        String   @map("file_name")
  fileSize        Int      @map("file_size") // bytes
  mimeType        String   @map("mime_type")
  storageKey      String   @map("storage_key")
  fileUrl         String?  @map("file_url") // Luôn null trong GĐ1 — không dùng URL công khai
  checksum        String?
  note            String?
  uploadedById    String   @map("uploaded_by_id")
  status          String   @default("ACTIVE") // ACTIVE | SUPERSEDED | WITHDRAWN (R3-C: giu ban cu, khong xoa)
  supersededById  String?  @map("superseded_by_id") // bang chung moi thay the
  withdrawnNote   String?  @map("withdrawn_note")
  createdAt       DateTime @default(now()) @map("created_at")

  workItem      PersonalWorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  monthlyResult MonthlyWorkResult? @relation(fields: [monthlyResultId], references: [id], onDelete: SetNull)
  adjustments   WorkEvidenceAdjustment[]
  uploadedBy    Person             @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@index([monthlyResultId])
  @@map("work_evidences")
}

// V3.0.3 — Quy trinh dieu chinh minh chung sau khi da xac nhan (R3-C, 2 cap)
// 1) Nguoi phu trách lap de nghi · 2) Lanh dao truc tiep da xac nhan xem xet ·
// 3) Truong bo phan phe duyet cuoi cung · 4) Ghi vet + giu ban minh chung cu
model WorkEvidenceAdjustment {
  id            String   @id @default(uuid())
  workItemId    String   @map("work_item_id")
  evidenceId    String?  @map("evidence_id") // bang chung can dieu chinh (null = de nghi bo sung moi)
  kind          String   // ADD | REPLACE | REMOVE
  reason        String   // ly do de nghi
  description   String?
  proposedFileName   String? @map("proposed_file_name")
  proposedStorageKey String? @map("proposed_storage_key")
  proposedSize       Int?    @map("proposed_size")
  proposedMime       String? @map("proposed_mime")
  state         String   @default("PROPOSED") // PROPOSED | LEADER_REVIEWED | APPROVED | REJECTED | BLOCKED
  proposedById String   @map("proposed_by_id")
  proposedAt   DateTime @default(now()) @map("proposed_at")
  leaderReviewedById String? @map("leader_reviewed_by_id")
  leaderReviewedAt   DateTime? @map("leader_reviewed_at")
  leaderNote   String?  @map("leader_note")
  approvedById String?  @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  approvalNote String?  @map("approval_note")
  appliedAt    DateTime? @map("applied_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workItem PersonalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  evidence WorkEvidence?   @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([workItemId, createdAt])
  @@index([state])
  @@map("work_evidence_adjustments")
}

// ----------------------------------------------------
// 4. BIỂU MẪU ĐỘNG & QUẢN LÝ PHIÊN BẢN (FORM ENGINE)
// ----------------------------------------------------

model FormTemplate {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions FormTemplateVersion[]

  @@map("form_templates")
}

model FormTemplateVersion {
  id             String    @id @default(uuid())
  formTemplateId String    @map("form_template_id")
  version        Int       @default(1)
  schemaJson     Json      @map("schema_json") // Schema fields definition
  status         String    @default("PUBLISHED") // DRAFT, PUBLISHED, RETIRED
  publishedAt    DateTime? @default(now()) @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  formTemplate FormTemplate       @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  submissions  ResultSubmission[]

  @@unique([formTemplateId, version])
  @@map("form_template_versions")
}

// ----------------------------------------------------
// 5. KỲ BÁO CÁO, KẾ HOẠCH & ĐẦU VIỆC CÁ NHÂN
// ----------------------------------------------------

model ReportingPeriod {
  id        String   @id @default(uuid())
  type      String   @default("WEEK") // DAY, WEEK, MONTH
  title     String
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  dueAt     DateTime? @map("due_at")
  isLocked  Boolean  @default(false) @map("is_locked")
  createdAt DateTime @default(now()) @map("created_at")

  plans     Plan[]
  workItems PersonalWorkItem[]
  routines  RoutineEntry[]
  snapshots ReportSnapshot[]

  @@unique([type, title])
  workItemAssignments WorkItemAssignment[]
  @@map("reporting_periods")
}

model Plan {
  id         String    @id @default(uuid())
  periodId   String    @map("period_id")
  unitId     String    @map("unit_id")
  creatorId  String    @map("creator_id")
  title      String
  status     String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, RETURNED, IN_EFFECT
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  period    ReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  unit      OrgUnit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  items     PlanItem[]
  versions  PlanVersion[]

  @@map("plans")
}

// Lịch sử phiên bản kế hoạch (E1): niêm snapshot trước mỗi lần mở khóa điều chỉnh,
// thay cho việc nhét JSON vào AuditEvent — query lại được, đối soát được.
model PlanVersion {
  id           String   @id @default(uuid())
  planId       String   @map("plan_id")
  version      Int
  statusBefore String   @map("status_before")
  statusAfter  String   @map("status_after")
  reason       String?
  snapshotData Json     @map("snapshot_data")
  createdById  String?  @map("created_by_id")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@map("plan_versions")
}

// Bộ đếm serial mã nhiệm vụ theo năm (E1): NV-YYYY-NNNN, tăng nguyên tử trong transaction.
model TaskCounter {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("task_counters")
}

model PlanItem {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  groupId   String?  @map("group_id")
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  group     ActivityGroup?     @relation(fields: [groupId], references: [id])
  // --- YC-38C: lien thong du lieu (additive) ---
  workItemId       String?  @map("work_item_id") // cong viec goc tuong ung voi hang muc ke hoach
  linkedWorkItem   PersonalWorkItem? @relation("PlanItemWorkItem", fields: [workItemId], references: [id], onDelete: SetNull)
  @@index([workItemId])
  workItems PersonalWorkItem[]
  taskLinks PlanTaskLink[]

  @@map("plan_items")
}

// Danh mục đầu việc thực tế của từng cá nhân theo kỳ (Biến động linh hoạt)
model PersonalWorkItem {
  id               String            @id @default(uuid())
  personId         String            @map("person_id")
  periodId         String            @map("period_id")
  planItemId       String?           @map("plan_item_id")
  templateId       String?           @map("template_id") // Nullable: có thể chọn từ mẫu hoặc tự thêm mới
  deptWorkItemId   String?           @map("dept_work_item_id") // YC-25: chọn từ danh mục đầu việc riêng của bộ phận
  productItemId    String?           @map("product_item_id") // YC-23: liên kết sản phẩm đầu ra theo QĐ1277 (tuỳ chọn)
  catalogEntryId   String?           @map("catalog_entry_id") // YC-31: đầu việc TX đã chọn (tuỳ chọn)
  // --- YC-38C: lien thong du lieu (additive) ---
  primaryOwnerPersonId String?       @map("primary_owner_person_id") // dau moi chu tri la CA NHAN (1 trong 2, khong ca ca nhan lan bo phan)
  primaryOwnerUnitId   String?       @map("primary_owner_unit_id")   // dau moi chu tri la BO PHAN (1 trong 2)
  sourceKind           String?       @map("source_kind")            // TX_CATALOG|QD1277_PRODUCT|PLAN|DEPT|LEGACY_TEMPLATE|DOCUMENT|MEETING|TASK|CUSTOM
  sourceRefId          String?       @map("source_ref_id")          // id tham chieu toi nguon
  sourceCodeSnapshot   String?       @map("source_code_snapshot")   // ma danh muc tai thoi diem tao (bat bien)
  seriesId             String?       @map("series_id")              // chuoi cong viec goc (ma goc on dinh qua nhieu ky)
  lineNo               Int           @default(1) @map("line_no")    // thu tu lut trong ky
  idempotencyKey       String?       @map("idempotency_key") // YC-38C: khoa idempotency cap request (token do client sinh)
  dueDate          DateTime?         @map("due_date") @db.Date // YC-32: hạn xử lý đầu việc (khác hạn chính thức của Task)
  completedDate    DateTime?         @map("completed_date") @db.Date // YC-32: ngày hoàn thành thực tế
  taskId           String?           @map("task_id") // YC-32: nhiệm vụ liên quan (lãnh đạo giao từ đầu việc)
  groupId          String?           @map("group_id") // Nullable: liên kết trực tiếp nhóm nghiệp vụ cho đầu việc tự tạo
  title            String
  workDate         DateTime?         @map("work_date") // Thứ / Ngày thực hiện
  dateText         String?           @map("date_text") // Nhãn ngày hiển thị tùy biến
  coordinationUnit String?           @map("coordination_unit") // Đơn vị phối hợp
  priority         String            @default("Trung bình") // Mức độ ưu tiên: Cao, Trung bình, Thấp
  expectedResult   String?           @map("expected_result") // Kết quả dự kiến
  sortOrder        Int               @default(0) @map("sort_order")
  status           String            @default("ACTIVE") // ACTIVE, NOT_STARTED, IN_PROGRESS, COMPLETED, DISCONTINUED
  // --- V3.0.1: vong doi duyet cong viec tu ghi nhan (additive) ---
  reviewState      String            @default("DRAFT") @map("review_state") // DRAFT | SUBMITTED | RETURNED | CONFIRMED
  resultText       String?           @map("result_text") // noi dung ket qua (B2: bat buoc khi bao hoan thanh)
  completedAt      DateTime?         @map("completed_at") // C1: thoi diem thao tac hoan thanh
  submittedAt      DateTime?         @map("submitted_at")
  submittedById    String?           @map("submitted_by_id")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewedById     String?           @map("reviewed_by_id")
  reviewNote       String?           @map("review_note") // ly do lanh dao tra lai
  submitCount      Int               @default(0) @map("submit_count")
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  person        Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  period        ReportingPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  planItem      PlanItem?          @relation(fields: [planItemId], references: [id])
  template      ActivityTemplate?  @relation(fields: [templateId], references: [id])
  deptWorkItem  DepartmentWorkItem? @relation(fields: [deptWorkItemId], references: [id], onDelete: SetNull)
  product       ProductItem?       @relation(fields: [productItemId], references: [id], onDelete: SetNull)
  catalogEntry  WorkCatalogEntry?  @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  task          Task?              @relation("WorkItemTask", fields: [taskId], references: [id], onDelete: SetNull)
  group         ActivityGroup?     @relation(fields: [groupId], references: [id])
  routines      RoutineEntry[]
  monthlyResults MonthlyWorkResult[]
  evidences     WorkEvidence[]
  evidenceAdjustments WorkEvidenceAdjustment[]

  primaryOwnerPerson Person?      @relation("WorkItemPrimaryOwner", fields: [primaryOwnerPersonId], references: [id], onDelete: SetNull)
  primaryOwnerUnit   OrgUnit?     @relation("WorkItemPrimaryOwnerUnit", fields: [primaryOwnerUnitId], references: [id], onDelete: SetNull)
  series             WorkItemSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  workItemAssignments WorkItemAssignment[]
  reviews             WorkItemReview[]
  linkedProducts     WorkItemProduct[]
  planItemWorkLinks  PlanItem[]   @relation("PlanItemWorkItem")
  workItemTasks      Task[]       @relation("TaskWorkItem")
  @@index([primaryOwnerPersonId])
  @@index([seriesId])
  @@index([catalogEntryId])
  @@index([taskId])
  @@map("personal_work_items")
}

// ----------------------------------------------------
// 6. NHIỆM VỤ, ĐIỀU HÀNH & TIẾN ĐỘ
// ----------------------------------------------------

model Task {
  id                 String   @id @default(uuid()) // Single Distinct Task ID
  code               String   @unique
  title              String
  description        String?
  ownerId            String   @map("owner_id")
  unitId             String   @map("unit_id")
  priority           String   @default("Cao") // Cao, Trung bình, Thấp
  status             String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, WAITING_REVIEW, DONE, CANCELED
  originalDeadline   DateTime @map("original_deadline")
  currentDeadline    DateTime @map("current_deadline")
  hasIssue           Boolean  @default(false) @map("has_issue")
  issueNotes         String?  @map("issue_notes")
  expectedResultText String?  @map("expected_result_text")
  actualResultText   String?  @map("actual_result_text")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // --- YC-38C: lien thong du lieu (additive) ---
  workItemId            String?  @map("work_item_id")         // cong viec goc (personal_work_items) ma nhiem vu nay thuoc ve
  createdById           String?  @map("created_by_id")        // nguoi tao (KHAC nguoi giao va nguoi chu tri)
  assignedById          String?  @map("assigned_by_id")       // nguoi giao viec
  sourceKind            String?  @map("source_kind")         // TX_CATALOG|QD1277_PRODUCT|PLAN|DEPT|LEGACY_TEMPLATE|DOCUMENT|MEETING|TASK|CUSTOM
  sourceRefId           String?  @map("source_ref_id")
  sourceCodeSnapshot    String?  @map("source_code_snapshot")
  // YC-38 (UAT fix): nguon phat sinh cua nhiem vu — KHONG thay the source_kind
  // (source_kind mang y nghia nguon DANH MUC: TX_CATALOG / QD1277_PRODUCT)
  originKind             String?  @map("origin_kind") // SELF_INITIATED | LEADER_ASSIGNED | PLAN | DOCUMENT_MEETING | OUTSIDE_DIRECTIVE | UNKNOWN
  owner            Person            @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  unit             OrgUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  planLinks        PlanTaskLink[]
  assignees        TaskAssignee[]
  updates          TaskUpdate[]
  deadlineRequests DeadlineRequest[]
  submissions      ResultSubmission[]
  attachments      TaskAttachment[]
  comments         TaskComment[]
  workItem         PersonalWorkItem? @relation("TaskWorkItem", fields: [workItemId], references: [id], onDelete: SetNull)
  @@index([workItemId])
  workItems        PersonalWorkItem[] @relation("WorkItemTask")

  @@map("tasks")
}

model PlanTaskLink {
  id         String   @id @default(uuid())
  planItemId String   @map("plan_item_id")
  taskId     String   @map("task_id")
  createdAt  DateTime @default(now()) @map("created_at")

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([planItemId, taskId])
  @@map("plan_task_links")
}

model TaskAssignee {
  taskId   String @map("task_id")
  personId String @map("person_id")
  role     String @default("COLLABORATOR") // COLLABORATOR, VIEWER

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
  @@map("task_assignees")
}

model TaskUpdate {
  id              String   @id @default(uuid())
  taskId          String   @map("task_id")
  authorId        String   @map("author_id")
  progressPercent Int      @default(0) @map("progress_percent")
  statusBefore    String?  @map("status_before")
  statusAfter     String?  @map("status_after")
  kind            String? // accept, submit, approve, return, progress, extend, cancel (null = dữ liệu cũ, suy luận khi đọc)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Person @relation(fields: [authorId], references: [id])

  @@map("task_updates")
}

model DeadlineRequest {
  id                String    @id @default(uuid())
  taskId            String    @map("task_id")
  requestedById     String    @map("requested_by_id")
  requestedDeadline DateTime  @map("requested_deadline")
  reason            String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById      String?   @map("reviewed_by_id")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewNotes       String?   @map("review_notes")
  createdAt         DateTime  @default(now()) @map("created_at")

  task        Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy Person @relation("RequestedBy", fields: [requestedById], references: [id])

  @@map("deadline_requests")
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  uploadedById String   @map("uploaded_by_id")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size") // bytes
  mimeType     String   @map("mime_type")
  storageKey   String   @map("storage_key")
  fileUrl      String   @map("file_url")
  isSigned     Boolean  @default(false) @map("is_signed")
  signedBy     String?  @map("signed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy Person @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  comment    TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId  String?      @map("comment_id")

  @@map("task_attachments")
}

// ----------------------------------------------------
// 19. TRAO ĐỔI TRONG NHIỆM VỤ (bình luận phẳng + đính file, không thread)
// ----------------------------------------------------

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      Person            @relation(fields: [authorId], references: [id])
  attachments TaskAttachment[]
  reactions   CommentReaction[]

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model CommentReaction {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  personId  String   @map("person_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  person  Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([commentId, personId, emoji])
  @@map("comment_reactions")
}

// ----------------------------------------------------
// 7. NHẬT KÝ THƯỜNG XUYÊN & KẾT QUẢ BÁO CÁO
// ----------------------------------------------------

model RoutineEntry {
  id               String   @id @default(uuid())
  periodId         String   @map("period_id")
  personId         String   @map("person_id")
  unitId           String   @map("unit_id")
  templateId       String?  @map("template_id")
  workItemId       String?  @map("work_item_id")
  occurrenceStatus String   @default("OCCURRED") @map("occurrence_status") // OCCURRED, NOT_OCCURRED
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  period      ReportingPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  person      Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit        OrgUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  template    ActivityTemplate? @relation(fields: [templateId], references: [id])
  workItem    PersonalWorkItem? @relation(fields: [workItemId], references: [id])
  submissions ResultSubmission[]

  @@map("routine_entries")
}

model ResultSubmission {
  id             String   @id @default(uuid())
  routineEntryId String?  @map("routine_entry_id")
  taskId         String?  @map("task_id")
  formVersionId  String   @map("form_version_id")
  submittedBy    String   @map("submitted_by")
  status         String   @default("SUBMITTED") // SUBMITTED, VERIFIED
  submittedAt    DateTime @default(now()) @map("submitted_at")

  routineEntry RoutineEntry?       @relation(fields: [routineEntryId], references: [id], onDelete: Cascade)
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  formVersion  FormTemplateVersion @relation(fields: [formVersionId], references: [id])
  values       SubmissionValue[]

  @@map("result_submissions")
}

model SubmissionValue {
  id           String  @id @default(uuid())
  submissionId String  @map("submission_id")
  fieldKey     String  @map("field_key")
  valueText    String? @map("value_text")
  valueNumber  Float?  @map("value_number")
  valueJson    Json?   @map("value_json")

  submission ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_values")
}

// ----------------------------------------------------
// 8. KIỂM TOÁN HỆ THỐNG (AUDIT LOG BẤT BIẾN)
// ----------------------------------------------------

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String   // CREATE, UPDATE, DELETE, LOGIN, EXPORT_XLSX, APPROVE_PLAN
  resourceType String   @map("resource_type") // Task, Plan, OrgUnit, etc.
  resourceId   String?  @map("resource_id")
  oldData      Json?    @map("old_data")
  newData      Json?    @map("new_data")
  ipAddress    String?  @map("ip_address")
  timestamp    DateTime @default(now())

  actor Account? @relation(fields: [actorId], references: [id])

  @@map("audit_events")
}

// ----------------------------------------------------
// 9. THÔNG BÁO ĐIỀU HÀNH & CẢNH BÁO TÁC NGHIỆP
// ----------------------------------------------------

model Notification {
  id             String    @id @default(uuid())
  recipientId    String    @map("recipient_id")
  category       String    @default("task") // "task", "approval", "deadline", "system"
  type           String    // TASK_ASSIGNED, TASK_WAITING_REVIEW, TASK_COMPLETED, TASK_REJECTED, TASK_OVERDUE, TASK_DUE_SOON, PLAN_SUBMITTED, PLAN_APPROVED, PLAN_RETURNED, DEADLINE_REQUEST_PENDING, DEADLINE_REQUEST_APPROVED, DEADLINE_REQUEST_REJECTED, ROUTINE_REMINDER
  title          String
  content        String
  tag            String    @default("THÔNG BÁO")
  tagType        String    @default("primary") @map("tag_type") // "danger", "primary", "success", "warning"
  entityType     String?   @map("entity_type") // "TASK", "PLAN", "DEADLINE_REQUEST", "ROUTINE"
  entityId       String?   @map("entity_id")
  actionUrl      String    @map("action_url")
  actionLabel    String    @default("Xem chi tiết") @map("action_label")
  taskCode       String?   @map("task_code")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  isDismissed    Boolean   @default(false) @map("is_dismissed")
  dismissedAt    DateTime? @map("dismissed_at")
  idempotencyKey String?   @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  recipient Person @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isDismissed, isRead])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

// ----------------------------------------------------
// 10. CHỐT KỲ SỐ LIỆU & LỊCH SỬ SNAPSHOT BẤT BIẾN
// ----------------------------------------------------

model ReportSnapshot {
  id           String    @id @default(uuid())
  code         String    @unique // Mã hiển thị: SNP-YYYYMMDD-XXXX
  periodId     String    @map("period_id")
  version      Int       @default(1)
  title        String
  snapshotData Json      @map("snapshot_data") // Dữ liệu báo cáo tại thời điểm chốt
  checksum     String    // Chuỗi mã băm SHA-256 (64 hex lowercase) tính từ snapshot_data chuẩn hóa
  lockedById   String    @map("locked_by_id")
  lockedByName String    @map("locked_by_name")
  lockedAt     DateTime  @default(now()) @map("locked_at")
  status       String    @default("LOCKED") // LOCKED, SUPERSEDED
  scopeUnitId  String?   @map("scope_unit_id")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  period    ReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  lockedBy  Person          @relation("SnapshotLocker", fields: [lockedById], references: [id])
  scopeUnit OrgUnit?        @relation(fields: [scopeUnitId], references: [id])

  @@unique([periodId, version])
  @@index([checksum])
  @@index([periodId, status])
  @@map("report_snapshots")
}

// ----------------------------------------------------
// 14. ĐƠN NGHỈ PHÉP/BÙ/CÔNG TÁC/CUỐI TUẦN (Đợt B v1: theo dõi + duyệt,
// chưa trừ hạn mức phép năm)
// ----------------------------------------------------

model LeaveRequest {
  id            String    @id @default(uuid())
  personId      String    @map("person_id")
  type          String // NGHI_PHEP, NGHI_BU, CONG_TAC, NGHI_CUOI_TUAN
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  reason        String
  handoverToId  String?   @map("handover_to_id")
  handoverNotes String?   @map("handover_notes")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELED
  reviewedById  String?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNotes   String?   @map("review_notes")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  person     Person  @relation("LeaveRequester", fields: [personId], references: [id], onDelete: Cascade)
  handoverTo Person? @relation("LeaveHandover", fields: [handoverToId], references: [id])

  @@index([personId, status])
  @@map("leave_requests")
}

// ----------------------------------------------------
// 16. LỊCH TRỰC CA (phân công trực theo ngày/ca/điểm)
// ----------------------------------------------------

model DutyRoster {
  id          String   @id @default(uuid())
  date        DateTime // Ngày trực (giờ 00:00)
  shift       String   @default("CA_NGAY") // SANG, CHIEU, CA_NGAY (giữ cho dữ liệu cũ)
  post        String? // Điểm trực kiểu cũ (giữ tương thích dữ liệu đã có)
  personId    String   @map("person_id")
  unitId      String?  @map("unit_id")
  notes       String?
  // --- YC-24: phân công theo biểu mẫu Hải quan (bản sao nội dung tại thời điểm phân công,
  //     sửa danh mục vị trí về sau KHÔNG làm đổi bản ghi cũ) ---
  positionId     String? @map("position_id") // FK danh mục vị trí/nhiệm vụ
  positionTitle  String? @map("position_title") // Bản sao tiêu đề nhiệm vụ
  positionDetail String? @map("position_detail") // Bản sao dòng phụ (VD: Kiểm tra Thuế, lệ phí HQ...)
  positionOrder  Int?    @map("position_order") // Số TT trên biểu in tại thời điểm phân công
  slotLabel      String? @map("slot_label") // Nhãn ô: NC / XC / Vị trí bãi Phú Anh... (null = ô không nhãn)
  slotOrder      Int?    @map("slot_order") // Thứ tự ô trong vị trí (0-based)
  slotKey        String? @map("slot_key") // Khóa chống trùng ô: "<positionId>#<slotOrder>"
  reason         String? // Lý do khi thay đổi người trực
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  person   Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit     OrgUnit?       @relation(fields: [unitId], references: [id])
  position DutyPosition?  @relation(fields: [positionId], references: [id], onDelete: SetNull)

  // YC-24 Phương án B: bảng phân công định danh theo (BỘ PHẬN + NGÀY + Ô).
  // - Bản ghi cũ (unit_id/slot_key NULL) không bị ảnh hưởng (PostgreSQL: NULL khác nhau trong unique index).
  // - Một ô của biểu chỉ có một bản ghi/bộ phận/ngày.
  @@unique([unitId, date, slotKey])
  @@index([unitId, date])
  @@index([date, positionId])
  @@map("duty_rosters")
}

// ----------------------------------------------------
// 16b. YC-24 — DANH MỤC VỊ TRÍ/NHIỆM VỤ PHÂN CÔNG (theo biểu mẫu "Sổ phân công nhiệm vụ")
//      + THÔNG TIN TỔNG HỢP THEO NGÀY (Tổng số công chức / Có mặt / Vắng / Lý do)
// ----------------------------------------------------

model DutyPosition {
  id          String   @id @default(uuid())
  code        String   @unique // Mã ổn định: YC24-01..YC24-08 (duy nhất toàn hệ thống)
  unitId      String?  @map("unit_id") // YC-24 Phương án B: bộ phận SỞ HỮU danh mục (null = chưa gán — chỉ Lãnh đạo đơn vị xử lý)
  title       String // Tiêu đề nhiệm vụ (dòng 1)
  detail      String? // Dòng phụ của mẫu (nếu có)
  slots       Json // Danh sách ô của vị trí: [{ "k": "s1", "l": null | "NC" | "Vị trí bãi Phú Anh" }]
  sortOrder   Int      @default(0) @map("sort_order") // Số TT trên biểu in
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE (ngừng sử dụng — không xóa)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   Person?      @relation("DutyPositionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  unit        OrgUnit?     @relation(fields: [unitId], references: [id])
  assignments DutyRoster[]

  @@index([unitId, status, sortOrder])
  @@map("duty_positions")
}

model DutyDayInfo {
  id           String   @id @default(uuid())
  date         DateTime // Ngày (giờ 00:00) — YC-24 Phương án B: định danh theo (BỘ PHẬN + NGÀY)
  unitId       String?  @map("unit_id") // Bộ phận (null = bản ghi cũ chưa gắn — không dùng cho bản ghi mới)
  totalStaff   Int?     @map("total_staff") // Tổng số công chức (nhập theo biểu)
  presentStaff Int?     @map("present_staff") // Có mặt
  absentCount  Int?     @map("absent_count") // Vắng
  absentReason String?  @map("absent_reason") // Lý do
  notes        String? // Ghi chú bổ sung của ngày
  createdById  String?  @map("created_by_id")
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  unit         OrgUnit? @relation(fields: [unitId], references: [id])

  @@unique([unitId, date])
  @@index([unitId])
  @@map("duty_day_infos")
}

// ----------------------------------------------------
// 17. BIÊN BẢN GIAO BAN → NHIỆM VỤ (kết luận họp sinh việc, chống rơi rớt)
// ----------------------------------------------------
model Meeting {
  id        String   @id @default(uuid())
  title     String
  meetingAt DateTime @map("meeting_at")
  chair     String?
  unitId    String?  @map("unit_id")
  notes     String?
  createdById String? @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conclusions MeetingConclusion[]

  @@index([meetingAt])
  @@map("meetings")
}

model MeetingConclusion {
  id          String    @id @default(uuid())
  meetingId   String    @map("meeting_id")
  content     String
  ownerId     String?   @map("owner_id")
  assigneeIds String[]  @map("assignee_ids")
  deadline    DateTime?
  priority    String    @default("Cao")
  taskId      String?   @map("task_id") // Task đã sinh (chống sinh trùng)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_conclusions")
}

// ----------------------------------------------------
// 18. SỔ VĂN BẢN ĐẾN/ĐI GỌN (tra ai đang giữ, hạn nào)
// ----------------------------------------------------

model OfficialDoc {
  id          String    @id @default(uuid())
  direction   String // DEN, DI
  number      String // Số hiệu văn bản
  title       String // Trích yếu
  fromTo      String?   @map("from_to") // Nơi gửi / nơi nhận
  docDate     DateTime? @map("doc_date")
  handlerId   String?   @map("handler_id")
  deadline    DateTime?
  status      String    @default("DANG_XU_LY") // DANG_XU_LY, HOAN_THANH, LUU_TRU
  taskId      String?   @map("task_id")
  notes       String?
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  handler Person? @relation(fields: [handlerId], references: [id])

  @@index([direction, status])
  @@map("official_docs")
}

// ----------------------------------------------------
// 15. WEB PUSH SUBSCRIPTIONS (thông báo đẩy về điện thoại)
// ----------------------------------------------------

model PushSubscription {
  id        String   @id @default(uuid())
  personId  String   @map("person_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("push_subscriptions")
}

// ----------------------------------------------------
// 11. THAM SỐ CẤU HÌNH HỆ THỐNG VẬN HÀNH
// ----------------------------------------------------

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique // taskDueSoonHours, taskMaxWarningItems, deadlineRequireReason, notifyOnTaskAssign, unitDisplayName
  value       String
  dataType    String   @default("STRING") @map("data_type") // NUMBER, BOOLEAN, STRING
  category    String   @default("TASK_MANAGEMENT") // TASK_MANAGEMENT, NOTIFICATION, DISPLAY, SECURITY
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("system_configs")
}

// ----------------------------------------------------
// 12. DANH MỤC SẢN PHẨM/CÔNG VIỆC THEO QĐ 1277/QĐ-BTC (YC-11)
// Khóa sản phẩm do hệ thống sinh (STT Excel trùng mỗi phần).
// Lịch sử hệ số được niêm trong MonthlyWorkResult tại thời điểm ghi nhận.
// ----------------------------------------------------

model ProductCatalogVersion {
  id          String   @id @default(uuid())
  code        String   @unique // DM-SP-2026-V1
  title       String
  sourceFile  String   @map("source_file")
  sourceSheet String   @map("source_sheet")
  qdRef       String?  @map("qd_ref") // 1277/QĐ-BTC ngày 27/5/2026
  status      String   @default("ACTIVE") // ACTIVE, SUPERSEDED
  createdAt   DateTime @default(now()) @map("created_at")

  groups ProductGroup[]
  items  ProductItem[]

  @@map("product_catalog_versions")
}

model ProductGroup {
  id        String   @id @default(uuid())
  versionId String   @map("version_id")
  code      String // Mã phần trong Excel (A, B, I...) — chỉ dùng hiển thị/gom nhóm
  title     String
  sortOrder Int      @default(0) @map("sort_order")

  version ProductCatalogVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  items   ProductItem[]

  @@map("product_groups")
}

model ProductItem {
  id            String   @id @default(uuid())
  versionId     String   @map("version_id")
  groupId       String?  @map("group_id")
  code          String   @unique // SP-2026-V1-0001 (hệ thống sinh, ổn định)
  sourceRow     Int      @map("source_row") // Dòng Excel gốc để đối soát
  sourceStt     String?  @map("source_stt") // STT gốc (trùng giữa các phần)
  taskName      String   @map("task_name") // Cột B: Nhiệm vụ
  detailWork    String?  @map("detail_work") // Cột C
  outputProduct String?  @map("output_product") // Cột D
  groupName     String?  @map("group_name") // Cột E: Phân nhóm
  maxScore      Float?   @map("max_score") // Cột F
  pointValue    Float?   @map("point_value") // Cột G
  convertFactor Float?   @map("convert_factor") // Cột H: hệ số quy đổi
  notes         String?
  status        String   @default("ACTIVE")

  version ProductCatalogVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  group   ProductGroup?         @relation(fields: [groupId], references: [id])
  results MonthlyWorkResult[]
  linkedWorkItems WorkItemProduct[]
  personalWorkItems PersonalWorkItem[]

  @@index([versionId, groupId])
  @@map("product_items")
}

// ----------------------------------------------------
// 13. KẾT QUẢ SẢN PHẨM THỰC TẾ THEO THÁNG (YC-12)
// productItemId null + needsReview = chờ đối chiếu danh mục (không tự gán sai).
// ----------------------------------------------------

// ----------------------------------------------------
// 21b. YC-38C - LIEN THONG DU LIEU CONG VIEC (additive)
// - Mot cong viec goc, nhieu nguoi tham gia (bang phan cong)
// - Mot dau moi chu tri: CA NHAN hoac BO PHAN
// - Cong viec nhieu ky giu mot ma goc (chuoi cong viec)
// - TX (danh muc cong viec) va QD1277 (danh muc san pham) la HAI KHAI NIEM DOC LAP
// ----------------------------------------------------

// Chuoi cong viec goc: ma on dinh xuyen nhieu ky danh gia
model WorkItemSeries {
  id          String   @id @default(uuid())
  seriesCode  String   @unique @map("series_code") // ma cong viec goc on dinh, vi du CV-2026-000123
  title       String
  ownerType   String   @default("PERSON") @map("owner_type") // PERSON | UNIT
  ownerId     String?  @map("owner_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy Person?          @relation("WorkItemSeriesCreator", fields: [createdById], references: [id], onDelete: SetNull)
  workItems PersonalWorkItem[]

  @@map("work_item_series")
}

// Phan cong: 1 cong viec goc - nhieu nguoi (KHONG nhan ban cong viec goc)
model WorkItemAssignment {
  id               String    @id @default(uuid())
  workItemId       String    @map("work_item_id")
  personId         String    @map("person_id")
  periodId         String    @map("period_id")
  role             String    @default("COLLABORATOR") // PRIMARY_OWNER | COLLABORATOR | REVIEWER
  status           String    @default("ASSIGNED") // ASSIGNED | ACCEPTED | IN_PROGRESS | DONE | REJECTED
  progressPercent  Int       @default(0) @map("progress_percent")
  completedDate    DateTime? @map("completed_date") @db.Date
  actualResultText String?   @map("actual_result_text")
  note             String?
  assignedById     String?   @map("assigned_by_id")
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  respondedAt      DateTime? @map("responded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workItem PersonalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  person   Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  period   ReportingPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([workItemId, personId, periodId])
  @@index([personId, periodId])
  @@map("work_item_assignments")
}

// V3.0.1 — Lich su xac nhan cong viec tu ghi nhan (A, A1, B2, C1, D1-A, R3-C)
model WorkItemReview {
  id          String           @id @default(uuid())
  workItemId  String           @map("work_item_id")
  action      String           // SUBMITTED | RETURNED | CONFIRMED
  note        String?
  resultText  String?          @map("result_text")
  completedOn DateTime?        @map("completed_on") @db.Date
  actorId     String           @map("actor_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  workItem PersonalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor    Person           @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@index([actorId])
  @@map("work_item_reviews")
}

// Lien ket 0..n san pham QD1277 voi 1 cong viec (KHONG cong diem, KHONG tinh trung)
model WorkItemProduct {
  id            String   @id @default(uuid())
  workItemId    String   @map("work_item_id")
  productItemId String   @map("product_item_id")
  quantity      Float?
  isPrimary     Boolean  @default(false) @map("is_primary")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  // --- V3.0.2: xac nhan tung san pham QD1277 doc lap (Q-B4/A-1, A-3, A-4) ---
  reviewState   String?  @map("review_state") // PROPOSED | CONFIRMED | REJECTED (null = chua dua vao luong V3)
  proposedById  String?  @map("proposed_by_id")
  proposedAt    DateTime? @map("proposed_at")
  confirmedById String?  @map("confirmed_by_id")
  confirmedAt   DateTime? @map("confirmed_at")
  quantityUnit  String?  @map("quantity_unit") // don vi tinh — can doi chieu, khong tu suy
  factorSnapshot Float?  @map("factor_snapshot") // he so tai thoi diem xac nhan (khong sua danh muc)
  factorSource  String?  @map("factor_source") // QD1277_PRODUCT

  workItem    PersonalWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  productItem ProductItem      @relation(fields: [productItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, productItemId])
  @@index([productItemId])
  @@map("work_item_products")
}

model MonthlyWorkResult {
  id                String    @id @default(uuid())
  personId          String    @map("person_id")
  periodYear        Int       @map("period_year")
  periodMonth       Int       @map("period_month")
  productItemId     String?   @map("product_item_id")
  workItemId        String?   @map("work_item_id") // YC-23: liên kết đầu việc thực tế trong kế hoạch cá nhân (chống ghi trùng)
  needsReview       Boolean   @default(false) @map("needs_review")
  taskId            String?   @map("task_id") // Liên kết nhiệm vụ khi có quan hệ thực tế
  title             String // Tên nhiệm vụ/công việc
  outputText        String?   @map("output_text") // Sản phẩm thực tế
  assignedQty       Float?    @map("assigned_qty") // Số lượng giao
  completedQty      Float?    @map("completed_qty") // Số lượng hoàn thành
  dueDate           DateTime? @map("due_date")
  completedDate     DateTime? @map("completed_date")
  evidenceRef       String?   @map("evidence_ref") // Minh chứng/số hiệu văn bản
  factorSnapshot    Float?    @map("factor_snapshot") // Hệ số tại thời điểm ghi nhận
  lateCount         Int       @default(0) @map("late_count")
  reworkCount       Int       @default(0) @map("rework_count")
  notes             String?
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // --- YC-38C: chong ghi trung (additive) ---
  idempotencyKey   String? @map("idempotency_key") // khoa idempotency: nguoi|cong viec|ky (NULL = ban ghi cu)
  subjectKind      String? @map("subject_kind")    // WORK_ITEM | PRODUCT_ITEM | TASK
  subjectId        String? @map("subject_id")
  lineNo           Int     @default(1) @map("line_no")
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productItem ProductItem? @relation(fields: [productItemId], references: [id])
  workItem    PersonalWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  evidences WorkEvidence[]

  @@unique([idempotencyKey])
  @@unique([personId, workItemId])
  @@index([personId, periodYear, periodMonth])
  @@map("monthly_work_results")
}

// ----------------------------------------------------
// 20. GÓP Ý & BÁO LỖI TRONG APP (gom phản hồi UAT về một mối)
// ----------------------------------------------------

model Feedback {
  id           String    @id @default(uuid())
  category     String    @default("GOP_Y") // GOP_Y, BAO_LOI, DE_XUAT
  content      String
  pagePath     String?   @map("page_path") // Màn hình lúc gửi — để biết lỗi ở đâu
  userAgent    String?   @map("user_agent")
  status       String    @default("NEW") // NEW, DONE
  adminNote    String?   @map("admin_note")
  personId     String    @map("person_id") // Người gửi
  resolvedById String?   @map("resolved_by_id") // Người đánh dấu xử lý xong
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([personId, createdAt])
  @@map("feedbacks")
}

// ----------------------------------------------------
// 21. SỐ LIỆU GIAO BAN & BÁO CÁO TUẦN (YC-16 → YC-22) — GIAI ĐOẠN 2
// Toàn bộ chỉ tiêu, đơn vị, quy trình xác nhận, chỉ tiêu giao, mốc lũy kế và
// phân công nhập liệu đều là CẤU HÌNH TRÊN GIAO DIỆN — không hardcode trong code.
// ----------------------------------------------------

model MetricGroup {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  metrics     MetricDefinition[]
  assignments MetricEntryAssignment[]
  sections    NarrativeSection[]
  reportBlocks ReportBlock[]

  @@map("metric_groups")
}

// valueKind:
//   FLOW    = "phát sinh trong kỳ" — cộng dồn các bản ghi trong kỳ (số thuế, kim ngạch, số vụ...)
//   BALANCE = "số dư thời điểm" — lấy bản ghi có ngày mới nhất ≤ ngày xem (công nợ, chờ tham vấn...)
//   DERIVED = "tự tính" — công thức từ các chỉ tiêu khác (tổng = a + b; còn phải thu = PS − đã thu + mốc...)
// unitType: VND | USD | COUNT ; displayScale: 1 = đơn vị gốc, 1e6 = triệu, 1e9 = tỷ (lưu gốc luôn là đơn vị gốc)
// derivation (JSON): { terms: [{ metricId, sign: 1 | -1 }], includeBaseline: boolean }
model MetricDefinition {
  id                String   @id @default(uuid())
  groupId           String   @map("group_id")
  code              String   @unique
  name              String
  unitType          String   @default("COUNT") @map("unit_type")
  unitLabel         String?  @map("unit_label")
  displayScale      Int      @default(1) @map("display_scale")
  decimals          Int      @default(0)
  valueKind         String   @default("FLOW") @map("value_kind")
  derivation        Json?
  requireConfirm    Boolean  @default(false) @map("require_confirm")
  showOnDashboard   Boolean  @default(false) @map("show_on_dashboard")
  dashboardOrder    Int      @default(0) @map("dashboard_order")
  allowBackdateDays Int      @default(0) @map("allow_backdate_days") // -1 = không giới hạn, N = trong N ngày gần nhất
  expectDaily       Boolean  @default(true) @map("expect_daily")
  active            Boolean  @default(true)
  note              String?
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  group           MetricGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classifications MetricClassification[]
  entries         MetricDailyEntry[]
  baselines       MetricBaseline[]
  targets         MetricPlanTarget[]

  @@index([groupId, sortOrder])
  @@map("metric_definitions")
}

model MetricClassification {
  id        String   @id @default(uuid())
  metricId  String   @map("metric_id")
  code      String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, code])
  @@map("metric_classifications")
}

// status: RECORDED (nhập là xong) | DRAFT (nháp — chỉ khi chỉ tiêu bật kiểm tra)
//         | SUBMITTED (đã gửi kiểm tra) | CONFIRMED (đã xác nhận) | NEEDS_FIX (cần điều chỉnh)
model MetricDailyEntry {
  id               String    @id @default(uuid())
  metricId         String    @map("metric_id")
  classificationId String    @default("") @map("classification_id")
  entryDate        DateTime  @map("entry_date") @db.Date
  valueNumeric     Decimal   @map("value_numeric") @db.Decimal(24, 4)
  status           String    @default("RECORDED")
  note             String?
  enteredById      String    @map("entered_by_id")
  submittedAt      DateTime? @map("submitted_at")
  confirmedById    String?   @map("confirmed_by_id")
  confirmedAt      DateTime? @map("confirmed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, classificationId, entryDate])
  @@index([entryDate])
  @@map("metric_daily_entries")
}

model MetricEntryRevision {
  id        String    @id @default(uuid())
  entryId   String    @map("entry_id")
  action    String // CREATE | UPDATE | DELETE | SUBMIT | CONFIRM | NEEDS_FIX | RECORDED
  oldValue  Decimal?  @map("old_value") @db.Decimal(24, 4)
  newValue  Decimal?  @map("new_value") @db.Decimal(24, 4)
  oldStatus String?   @map("old_status")
  newStatus String?   @map("new_status")
  reason    String?
  editedById String   @map("edited_by_id")
  editedAt  DateTime  @default(now()) @map("edited_at")

  @@index([entryId, editedAt])
  @@map("metric_entry_revisions")
}

// cumKind:
//   MONTH | QUARTER | YEAR = mốc lũy kế kỳ (chỉ áp dụng khi ngày mốc nằm trong đúng kỳ đang xem)
//   LEDGER                 = mốc số dư liên tục (áp dụng từ ngày mốc trở đi, không hết hạn)
// status: PROPOSED | CONFIRMED — chỉ mốc CONFIRMED mới được dùng để tính lũy kế.
model MetricBaseline {
  id               String    @id @default(uuid())
  metricId         String    @map("metric_id")
  classificationId String    @default("") @map("classification_id")
  cumKind          String    @map("cum_kind")
  asOfDate         DateTime  @map("as_of_date") @db.Date
  valueNumeric     Decimal   @map("value_numeric") @db.Decimal(24, 4)
  sourceNote       String?   @map("source_note")
  status           String    @default("PROPOSED")
  proposedById     String?   @map("proposed_by_id")
  confirmedById    String?   @map("confirmed_by_id")
  confirmedAt      DateTime? @map("confirmed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, classificationId, cumKind, asOfDate])
  @@map("metric_baselines")
}

// periodType: YEAR | QUARTER | MONTH — periodNo: tháng 1-12 / quý 1-4 / null nếu YEAR
// label: tên chỉ tiêu giao (VD: "Chỉ tiêu BTC", "Chỉ tiêu UBND", "KH tháng", "Chỉ tiêu giao")
model MetricPlanTarget {
  id               String   @id @default(uuid())
  metricId         String   @map("metric_id")
  classificationId String   @default("") @map("classification_id")
  label            String
  periodType       String   @map("period_type")
  year             Int
  periodNo         Int?     @map("period_no")
  valueNumeric     Decimal  @map("value_numeric") @db.Decimal(24, 4)
  note             String?
  updatedById      String?  @map("updated_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, classificationId, label, periodType, year, periodNo])
  @@map("metric_plan_targets")
}

// Phân công nhập liệu: hoặc theo NHÓM (groupId) hoặc theo CHỈ TIÊU (metricId).
// Leader luôn nhập/xác nhận được mọi chỉ tiêu; cán bộ chỉ trong phạm vi được phân công.
model MetricEntryAssignment {
  id                String    @id @default(uuid())
  personId          String    @map("person_id")
  groupId           String?   @map("group_id")
  metricId          String?   @map("metric_id")
  canEnter          Boolean   @default(true) @map("can_enter")
  canConfirm        Boolean   @default(false) @map("can_confirm")
  allowBackdateDays Int?      @map("allow_backdate_days")
  validFrom         DateTime? @map("valid_from") @db.Date
  validTo           DateTime? @map("valid_to") @db.Date
  active            Boolean   @default(true)
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  group MetricGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([personId, active])
  @@map("metric_entry_assignments")
}

model NarrativeSection {
  id        String   @id @default(uuid())
  code      String   @unique
  title     String
  groupId   String?  @map("group_id")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group        MetricGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  narratives   BriefingNarrative[]
  reportBlocks ReportBlock[]

  @@map("narrative_sections")
}

// periodType: WEEK | MONTH | QUARTER | YEAR — periodKey: "2026-W42" | "2026-10" | "2026-Q4" | "2026"
model BriefingNarrative {
  id          String   @id @default(uuid())
  sectionId   String   @map("section_id")
  periodType  String   @map("period_type")
  periodKey   String   @map("period_key")
  content     String
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  section NarrativeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, periodType, periodKey])
  @@map("briefing_narratives")
}

// Cấu trúc báo cáo giao ban (GĐ3) — các khối hiển thị theo thứ tự trong bản xem trước & file Word.
// kind:
//   HEADING      = tiêu đề mục (chỉ có dòng tiêu đề)
//   METRIC_GROUP = tiêu đề + bảng số liệu tự tổng hợp của một nhóm chỉ tiêu (groupId)
//   NARRATIVE    = tiêu đề (có thể rỗng) + nội dung nhận xét theo kỳ của một mục (sectionId)
model ReportBlock {
  id        String   @id @default(uuid())
  code      String   @unique
  title     String   @default("")
  kind      String   @default("HEADING")
  groupId   String?  @map("group_id")
  sectionId String?  @map("section_id")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group   MetricGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  section NarrativeSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("report_blocks")
}

// Bản chụp báo cáo giao ban đã lưu (snapshot). Báo cáo đã chốt KHÔNG tự đổi khi số liệu nguồn sửa:
// mọi số liệu hiển thị đã được định dạng sẵn trong contentJson tại thời điểm lưu.
// periodType/periodKey giống BriefingNarrative. versionNo tăng dần theo từng kỳ.
model BriefingReportVersion {
  id           String   @id @default(uuid())
  periodType   String   @map("period_type")
  periodKey    String   @map("period_key")
  versionNo    Int      @map("version_no")
  title        String
  subtitle     String?
  meetingStart String?  @map("meeting_start")
  meetingEnd   String?  @map("meeting_end")
  contentJson  Json     @map("content_json")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([periodType, periodKey, versionNo])
  @@index([periodType, periodKey])
  @@map("briefing_report_versions")
}


// ----------------------------------------------------
// 23. YC-33 - KET QUA TINH DIEM (snapshot ky + phien ban cong thuc)
// Khong luu FK sang bang khac de DDL additive an toan; moi lien he doc bang truy van.
// ----------------------------------------------------

/// Mot lan tinh diem cho mot ky cua mot nguoi. Luu snapshot cong thuc + phien ban
/// danh muc/san pham de doi chieu lai duoc sau nay.
model ScoreRun {
  id                String   @id @default(uuid())
  personId          String   @map("person_id")
  periodType        String   @map("period_type") // MONTH | QUARTER
  periodYear        Int      @map("period_year")
  periodNumber      Int      @map("period_number") // thang 1-12 hoac quy 1-4
  formulaVersion    String   @map("formula_version") // ban cong thuc da xac nhan
  productVersionId  String?  @map("product_version_id") // phien ban QD1277 dung khi tinh
  catalogVersionId  String?  @map("catalog_version_id") // phien ban danh muc TX dung khi tinh
  status            String   @default("DRAFT") // DRAFT | CONFIRMED | STALE
  overallScore      Float?   @map("overall_score")
  summaryJson       Json?    @map("summary_json")
  reasonsJson       Json?   @map("reasons_json")
  computedById      String?  @map("computed_by_id")
  computedAt        DateTime @default(now()) @map("computed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  items ScoreRunItem[]

  @@unique([personId, periodType, periodYear, periodNumber, formulaVersion])
  @@index([periodType, periodYear, periodNumber])
  @@index([personId, periodType])
  @@map("score_runs")
}

/// Chi tiet tung dong cong viec trong mot lan tinh diem.
model ScoreRunItem {
  id                String   @id @default(uuid())
  scoreRunId        String   @map("score_run_id")
  workItemId        String?  @map("work_item_id")
  taskId            String?  @map("task_id")
  monthlyResultId   String?  @map("monthly_result_id")
  sequence          Int      @default(0)
  title             String
  /// Nguon he so: TX_CATALOG | QD1277_PRODUCT | MANUAL | MISSING
  /// (YC-33: KHONG coi he so TX la he so QD1277 khi chua co mapping hop le)
  factorSource      String   @map("factor_source")
  factor            Float?
  factorSnapshot    Json?    @map("factor_snapshot")
  assignedQty       Float?   @map("assigned_qty")
  completedQty      Float?   @map("completed_qty")
  lateDays          Int      @default(0) @map("late_days")
  reworkCount       Int      @default(0) @map("rework_count")
  gAssignedConverted Float?  @map("g_assigned_converted")
  iCompletedConverted Float? @map("i_completed_converted")
  lProgressConverted  Float? @map("l_progress_converted")
  nQualityConverted   Float? @map("n_quality_converted")
  /// KNOWN | INSUFFICIENT_DATA | PENDING_RULE | NOT_APPLICABLE | ERROR
  status            String   @default("KNOWN")
  reasons           Json?
  createdAt         DateTime @default(now()) @map("created_at")

  scoreRun ScoreRun @relation(fields: [scoreRunId], references: [id], onDelete: Cascade)

  @@index([scoreRunId, sequence])
  @@map("score_run_items")
}

// ----------------------------------------------------
// 24. YC-36 - TU DANH GIA, NHAN XET, XEP LOAI DE XUAT
// ----------------------------------------------------

/// Phieu tu danh gia cua mot can bo trong mot ky. Luu rieng:
///
/// - gia tri goi y cua he thong (chi khi co du cong thuc da xac nhan)
/// - gia tri ca nhan sua
/// - goi y muc xep loai + muc ca nhan chon
/// - uu diem / han che
/// - nhan xet cua nguoi danh gia (mac dinh de trong)
model EvaluationAssessment {
  id                      String   @id @default(uuid())
  subjectPersonId         String   @map("subject_person_id")
  periodType              String   @map("period_type") // MONTH | QUARTER
  periodYear              Int      @map("period_year")
  periodNumber            Int      @map("period_number")
  periodStart             DateTime @map("period_start")
  periodEnd               DateTime @map("period_end")
  roleAtPeriod            String?  @map("role_at_period") // STAFF | UNIT_LEADER | DEPARTMENT_LEADER
  isLeaderSubject         Boolean  @default(false) @map("is_leader_subject")
  /// Diem tieu chi chung GOI Y (NULL = chua co quy tac du dieu kien)
  commonCriteriaSuggested Float?   @map("common_criteria_suggested")
  /// Diem tieu chi chung do ca nhan tu cham (sau khi sua)
  commonCriteriaScore     Float?   @map("common_criteria_score")
  /// Diem ket qua thuc hien nhiem vu (tu YC-33)
  taskResultScore         Float?   @map("task_result_score")
  /// Muc xep loai GOI Y cua he thong (chi khi co quy tac du dieu kien)
  selfGradeSuggestion     String?  @map("self_grade_suggestion")
  /// Muc xep loai ca nhan chon (de xuat tu ban than)
  selfGradeChoice         String?  @map("self_grade_choice")
  /// KET QUA XEP LOAI CUOI CUNG do cap co tham quyen quyet dinh
  /// (theo CV 2431: Truong don vi DE XUAT, Chi cuc truong QUYET DINH, phe duyet)
  finalGrade              String?  @map("final_grade")
  finalGradeById          String?  @map("final_grade_by_id")
  finalGradeAt            DateTime? @map("final_grade_at")
  finalGradeNote          String?  @map("final_grade_note")
  /// Uu diem
  strengths               String?
  /// Han che / khuyet diem
  weaknesses              String?
  /// Y kien nhan xet cua cap co tham quyen (mac dinh de trong - co the nhap hoac de trong tren ban in)
  reviewerComment         String?  @map("reviewer_comment")
  reviewerId              String?  @map("reviewer_id")
  reviewTimestamp         DateTime? @map("review_timestamp")
  /// DRAFT | SUBMITTED | REVIEWED | CONFIRMED
  evaluationStatus        String   @default("DRAFT") @map("evaluation_status")
  formulaVersion          String?  @map("formula_version")
  createdById             String?  @map("created_by_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([subjectPersonId, periodType, periodYear, periodNumber])
  @@index([periodType, periodYear, periodNumber])
  @@index([evaluationStatus])
  @@map("evaluation_assessments")
}

// ----------------------------------------------------
// 25. YC-35 - QUAN HE PHU TRACH THEO KY
// Khong suy dien tu role ky thuat; chi ghi khi Hai quan xac nhan.
// ----------------------------------------------------

/// Quan he "nguoi phu truc cho nguoi nay" trong mot khoang thoi gian.
model PersonSupervision {
  id                   String   @id @default(uuid())
  managerPersonId      String   @map("manager_person_id")
  subordinatePersonId  String   @map("subordinate_person_id")
  /// Don vi cong tac cua nguoi duoi quyen
  scopeType            String   @default("UNIT") @map("scope_type") // UNIT | WORK_AREA
  scopeNote            String?  @map("scope_note")
  effectiveFrom        DateTime @default(now()) @map("effective_from")
  effectiveTo          DateTime? @map("effective_to")
  /// DRAFT | CONFIRMED | REVOKED
  status               String   @default("CONFIRMED")
  confirmedById        String?  @map("confirmed_by_id")
  confirmedAt          DateTime? @map("confirmed_at")
  note                 String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([managerPersonId, subordinatePersonId, effectiveFrom])
  @@index([subordinatePersonId, status])
  @@index([managerPersonId, status])
  @@map("person_supervisions")
}

// ----------------------------------------------------
// 26. YC-37 - HO SO CHAP THUAN / TU CHOI / YEU CAU GIAI TRINH
// Mot "case" = mot ho so xin quyet dinh. Moi luot quyet dinh = mot ApprovalDecision
// => giu toan bo lich su chap thuan / tu choi / giai trinh / phan hoi.
// ----------------------------------------------------

model ApprovalCase {
  id             String    @id @default(uuid())
  /// TASK_RESULT | PLAN | DEADLINE_REQUEST | PERSONAL_EVALUATION
  caseType       String    @map("case_type")
  /// id doi tuong nghiep vu (Task.id / Plan.id / DeadlineRequest.id / ...)
  resourceId     String    @map("resource_id")
  resourceCode   String?   @map("resource_code")
  title          String
  unitId         String?   @map("unit_id")
  /// personId nguoi trinh ho so
  submittedById  String?   @map("submitted_by_id")
  /// OPEN | AGREED | REJECTED | CLARIFY_REQUESTED | CLOSED
  status         String    @default("OPEN")
  currentRound   Int       @default(1) @map("current_round")
  decidedById    String?   @map("decided_by_id")
  decidedAt      DateTime? @map("decided_at")
  deadlineAt     DateTime? @map("deadline_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  decisions ApprovalDecision[]

  @@unique([caseType, resourceId])
  @@index([status, createdAt])
  @@index([submittedById, status])
  @@map("approval_cases")
}

model ApprovalDecision {
  id            String   @id @default(uuid())
  caseId        String   @map("case_id")
  round         Int      @default(1)
  /// AGREE | REJECT | CLARIFY | RESPOND
  action        String
  /// Ly do (bat buoc khi REJECT)
  reason        String?
  /// Noi dung can giai trinh (CLARIFY) hoac noi dung phan hoi (RESPOND)
  content       String?
  /// accountId nguoi thuc hien quyet dinh
  actorId       String   @map("actor_id")
  actorPersonId String?  @map("actor_person_id")
  createdAt     DateTime @default(now()) @map("created_at")

  case ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, round])
  @@index([actorId, createdAt])
  @@map("approval_decisions")
}
