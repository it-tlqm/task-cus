# ==============================================================================
# TALUNG-CUS-WORK — BIẾN MÔI TRƯỜNG CHUẨN PRODUCTION
# Sao chép tệp này thành .env.production trên máy chủ và cập nhật các giá trị mật
# ==============================================================================

# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (Nội bộ Docker hoặc máy chủ chuyên dụng)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ThayBangMatKhauBaoMatTren16KyTu!@#
POSTGRES_DB=talung_cus_work

# Chuỗi kết nối Prisma (Khi chạy trong Docker Compose kết nối tới container db)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# 2. KHÓA BẢO MẬT PHIÊN LÀM VIỆC (JWT)
# Tạo chuỗi ngẫu nhiên 256-bit (ví dụ: openssl rand -base64 32)
JWT_SECRET="ThayTheBangChuoiKhoaBiMat256BitNgauNhienDungRiengChoHaiQuanTaLung2026"

# 3. CẤU HÌNH VẬN HÀNH & HIỂN THỊ
NEXT_PUBLIC_APP_TITLE="Hệ thống Quản lý Kế hoạch & Điều hành Tác nghiệp Hải quan Cửa khẩu Quốc tế Tà Lùng"

# 4. BẢO MẬT ĐĂNG NHẬP (BẮT BUỘC ĐẶT FALSE TRÊN MÔI TRƯỜNG THẬT)
# Đặt false để ẩn hoàn toàn danh sách 4 tài khoản Demo trên trang Đăng nhập
ENABLE_DEMO_LOGIN="false"

# 5. CỔNG MẠNG & THÔNG SỐ SERVER
HTTP_PORT=80
HTTPS_PORT=443
NODE_ENV=production

# 6. AI HỖ TRỢ (Google Gemini) — lấy key miễn phí tại https://aistudio.google.com/apikey
# Bỏ trống thì toàn bộ nút AI tự ẩn, hệ thống chạy bình thường không lỗi.
# Model cố định trong code: Flash mới nhất → tự lùi Flash Lite (~500 lượt/ngày) khi hết hạn mức.
GOOGLE_GENERATIVE_AI_KEY="AIza...dan-key-vao-day"
